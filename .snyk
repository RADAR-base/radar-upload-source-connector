# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-AXIOS-16299921:
    - '*':
        reason: >
          Improperly Controlled Modification of Dynamically-Determined Object Attributes in
          axios@1.7.7. Fixed by upgrading axios@1.7.7 to 1.16.0, which is not part of this change.
          Ignored while dependency scanning moves from Snyk to Trivy, which will report it from then
          on.
